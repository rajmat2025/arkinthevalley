# Hostinger hPanel → Node.js app → Environment variables
# Add these in the deployment UI (do not commit real keys to Git).

NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here
NODE_ENV=production

# Persistent site content (survives redeploy — edit THIS file, not nodejs/src/data/)
